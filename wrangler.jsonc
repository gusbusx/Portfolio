// Cloudflare Worker config: serves the portfolio's static files and runs the contact form API.
{
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Keep the variables you set in the Cloudflare dashboard (RESEND_API_KEY, CONTACT_TO, CONTACT_FROM) when deploying.
  "keep_vars": true
}
